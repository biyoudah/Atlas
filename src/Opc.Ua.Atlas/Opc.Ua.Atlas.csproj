<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Opc.Ua.Atlas</AssemblyName>
    <OutputType>Exe</OutputType>
    <PackageId>Atlas.OpcUa</PackageId>
    <Description>Atlas — Address space discovery, profiling, and turnkey visualization engine for OPC UA.</Description>
    <PackageTags>opc-ua;opcua;discovery;catalog;crawler;prometheus;grafana;iiot</PackageTags>
    <RootNamespace>Opc.Ua.Atlas</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="2.0.1" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Packs\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
