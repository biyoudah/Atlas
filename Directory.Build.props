<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Atlas Project Contributors</Authors>
    <Company>Atlas Open Source Project</Company>
    <Product>Atlas OPC UA Telemetry &amp; Semantic Discovery Engine</Product>
    <Copyright>Copyright © 2026 Atlas Project Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/atlas-industrial/atlas</RepositoryUrl>
  </PropertyGroup>
</Project>
