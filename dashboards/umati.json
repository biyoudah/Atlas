{
  "id": null,
  "uid": "atlas-catalog",
  "title": "umati International MachineTool Live (Atlas Engine)",
  "tags": [
    "opcua",
    "atlas",
    "umati",
    "cnc",
    "industry-4.0"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "1s",
  "schemaVersion": 38,
  "version": 4,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "CNC / Machine",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(opcua_feed_override, device)",
        "query": {
          "query": "label_values(opcua_feed_override, device)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Fleet Feed Override Potentiometers (%)",
      "description": "Visualisation industrielle claire des vitesses d'avance par machine et par canal",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "opcua_feed_override{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{channel}})",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizWidth": 10,
        "minVizHeight": 16,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 150,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 100, "color": "#EAB839" },
              { "value": 120, "color": "red" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Fleet Operational States (OPC 40501)",
      "description": "État de fonctionnement temps réel par machine",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "opcua_operating_mode{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "AUTOMATIC", "color": "green" },
                "0": { "text": "STOPPED", "color": "yellow" },
                "2": { "text": "MANUAL", "color": "blue" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active WAN Telemetry",
      "description": "Variables industrielles souscrites en continu sur opcua.umati.app",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "atlas_collector_monitored_items_active",
          "legendFormat": "Nodes",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "QualityGuard Anomaly Isolation",
      "description": "Nœuds corrompus ou sans données isolés automatiquement par Atlas",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(opcua_data_stale == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 9999,
                "result": { "text": "ANOMALIES ISOLÉES", "color": "orange" }
              }
            },
            {
              "type": "value",
              "options": {
                "0": { "text": "FLUX 100% SAIN", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Feed Override Potentiometer History (1s Scrape)",
      "description": "Historique précis d'avance. Tooltip ciblé sur la courbe survolée pour une lisibilité parfaite.",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "opcua_feed_override{device=~\"$device\"}",
          "legendFormat": "{{device}} ({{channel}})",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["lastNotNull", "min", "max"]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "fillOpacity": 8
          }
        }
      }
    }
  ]
}
